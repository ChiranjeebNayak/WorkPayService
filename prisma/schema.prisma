generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model admin {
  id       Int        @id @default(autoincrement())
  name     String
  phone    String     @unique(map: "Admin_phone_key")
  email    String     @unique(map: "Admin_email_key")
  password String
  employee employee[]
}

model attendance {
  id              Int               @id @default(autoincrement())
  empId           Int
  date            DateTime
  checkInTime     DateTime
  checkOutTime    DateTime?
  workTime        Int               @default(0)
  parentSessionId Int?
  sessionType     String            @default("WORK")
  status          attendance_status @default(PRESENT)
  employee        employee          @relation(fields: [empId], references: [id], map: "Attendance_empId_fkey")

  @@index([empId, date], map: "Attendance_empId_date_idx")
}

model employee {
  id            Int             @id @default(autoincrement())
  name          String
  phone         String          @unique(map: "Employee_phone_key")
  email         String          @unique(map: "Employee_email_key")
  password      String
  baseSalary    Int
  overtimeRate  Int
  leaveBalance  Int             @default(10)
  officeId      Int
  adminId       Int
  joinedDate    DateTime?
  status        employee_status @default(ACTIVE)
  accountNumber String?
  ifscCode      String?
  attendance    attendance[]
  admin         admin           @relation(fields: [adminId], references: [id], map: "Employee_adminId_fkey")
  office        office          @relation(fields: [officeId], references: [id], map: "Employee_officeId_fkey")
  leave         leave[]
  transaction   transaction[]

  @@index([adminId], map: "Employee_adminId_fkey")
  @@index([officeId], map: "Employee_officeId_fkey")
}

model holiday {
  id          Int      @id @default(autoincrement())
  description String
  date        DateTime
}

model leave {
  id        Int          @id @default(autoincrement())
  empId     Int
  reason    String
  applyDate DateTime     @default(now())
  fromDate  DateTime
  toDate    DateTime
  totalDays Int
  status    leave_status @default(PENDING)
  type      leave_type
  employee  employee     @relation(fields: [empId], references: [id], map: "Leave_empId_fkey")

  @@index([empId], map: "Leave_empId_fkey")
}

model office {
  id        Int        @id @default(autoincrement())
  latitude  Float
  longitude Float
  checkin   DateTime
  checkout  DateTime
  breakTime Int        @default(0)
  name      String
  range     Int        @default(1000)
  employee  employee[]
}

model transaction {
  id          Int                 @id @default(autoincrement())
  empId       Int
  amount      Int
  date        DateTime
  payType     transaction_payType
  description String?
  employee    employee            @relation(fields: [empId], references: [id], map: "Transaction_empId_fkey")

  @@index([empId], map: "Transaction_empId_fkey")
}

enum transaction_payType {
  ADVANCE
  SALARY
  OVERTIME
  DEDUCTION
}

enum leave_status {
  PENDING
  APPROVED
  REJECTED
}

enum attendance_status {
  PRESENT
  ABSENT
  LATE
  LEAVE
  HOLIDAY
}

enum leave_type {
  PAID
  UNPAID
}

enum employee_status {
  ACTIVE
  INACTIVE
}
