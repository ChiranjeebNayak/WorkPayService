# ================================================================
# WorkPayService (Backend API) Environment Configuration Template
# ================================================================
# Copy this file to '.env' in the WorkPayService project root:
#   cp .env.example .env
# ================================================================

# ----------------------------------------------------------------
# 1. Database Connection URL (PostgreSQL)
# ----------------------------------------------------------------
# Required by Prisma ORM for database connection, migrations, and queries.
# Format: postgresql://<USER>:<PASSWORD>@<HOST>:<PORT>/<DATABASE>?schema=public&sslmode=require
DATABASE_URL="postgresql://postgres:password@localhost:5432/workpay?schema=public"

# (Optional) Additional connection strings if utilizing specific connection pools / providers:
# DATABASE_POSTGRES_URL="postgresql://postgres:password@localhost:5432/workpay?sslmode=require"
# DATABASE_PRISMA_DATABASE_URL="postgresql://postgres:password@localhost:5432/workpay?sslmode=require"

# ----------------------------------------------------------------
# 2. Server Port
# ----------------------------------------------------------------
# The port on which the Express server will listen (defaults to 3000 if omitted)
PORT=3000

# ----------------------------------------------------------------
# 3. JWT Signing Secret
# ----------------------------------------------------------------
# Secret key used to sign and verify JSON Web Tokens for Admin and Employee authentication.
# In production, use a cryptographically strong, random string (at least 32 characters).
# You can generate one via: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET="replace-with-a-strong-random-secret-in-production"

# ----------------------------------------------------------------
# 4. Environment Mode
# ----------------------------------------------------------------
# Set to 'development' during local dev or 'production' for live deployments
NODE_ENV=development
